# Base URL of your self-hosted Ente "museum" API instance (no trailing slash).
# Example: https://api.ente.example.com
ENTE_API_URL=http://localhost:8080

# Optional: separate host used for downloading file blobs.
# Leave empty to use ENTE_API_URL + /files/download/{id}.
ENTE_DOWNLOAD_URL=

# Network timeout (seconds) for upstream museum requests.
ENTE_TIMEOUT=60

# How long (seconds) an issued session token stays valid in memory.
SESSION_TTL=86400

# HTTP host/port for this adapter.
HOST=0.0.0.0
PORT=8000
